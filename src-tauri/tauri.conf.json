{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.fahh.editor",
  "productName": "Fahh Editor",
  "mainBinaryName": "fahh-editor",
  "version": "0.6.8",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "resources": {
      "assets/fahh.mp3": "assets/fahh.mp3"
    },
    "publisher": "Stealth Keqing",
    "copyright": "Copyright (c) 2026 Stealth Keqing. MIT License.",
    "homepage": "https://fahhide.duckdns.org",
    "category": "DeveloperTool",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Code editor with a spatial canvas, a local coding agent, and the fahh",
    "longDescription": "Fahh Editor is a desktop code editor built on Tauri 2 and Monaco: debugging, a real terminal, git, a 2D spatial canvas, and Fahh Local, a bring-your-own-key coding agent. It plays the fahh when your code breaks."
  },
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "windows": [
      {
        "title": "Fahh Editor",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {}
  }
}
