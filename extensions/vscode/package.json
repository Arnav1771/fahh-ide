{
  "name": "fahh-local-chat",
  "displayName": "Fahh Local Chat",
  "description": "Fahh Editor's coding agent (fahh-agent) as a chat in VS Code: it reads, edits and runs things in your workspace, and asks before it changes anything. Groq, Gemini, NVIDIA, OpenRouter, Anthropic or a local Ollama.",
  "version": "0.3.1",
  "publisher": "stealth-keqing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arnav1771/fahh-ide"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "agent",
    "ai",
    "fahh",
    "groq",
    "gemini",
    "openrouter",
    "anthropic",
    "ollama"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fahhLocalChat",
          "title": "Fahh Local Chat",
          "icon": "media/bot.svg"
        }
      ]
    },
    "views": {
      "fahhLocalChat": [
        {
          "type": "webview",
          "id": "fahhLocalChat.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "fahhLocalChat.newSession",
        "title": "Fahh Local Chat: New Session",
        "icon": "$(add)"
      },
      {
        "command": "fahhLocalChat.resume",
        "title": "Fahh Local Chat: Resume a Session",
        "icon": "$(history)"
      },
      {
        "command": "fahhLocalChat.pickModel",
        "title": "Fahh Local Chat: Choose Model",
        "icon": "$(server-environment)"
      },
      {
        "command": "fahhLocalChat.pickProvider",
        "title": "Fahh Local Chat: Choose Provider"
      },
      {
        "command": "fahhLocalChat.setApiKey",
        "title": "Fahh Local Chat: Manage API Keys",
        "icon": "$(key)"
      },
      {
        "command": "fahhLocalChat.settings",
        "title": "Fahh Local Chat: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fahhLocalChat.stop",
        "title": "Fahh Local Chat: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "fahhLocalChat.checkForUpdates",
        "title": "Fahh Local Chat: Check for Updates"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fahhLocalChat.newSession",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@1"
        },
        {
          "command": "fahhLocalChat.resume",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@2"
        },
        {
          "command": "fahhLocalChat.settings",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@3"
        },
        {
          "command": "fahhLocalChat.pickModel",
          "when": "view == fahhLocalChat.chat",
          "group": "more@1"
        },
        {
          "command": "fahhLocalChat.setApiKey",
          "when": "view == fahhLocalChat.chat",
          "group": "more@2"
        }
      ]
    },
    "configuration": {
      "title": "Fahh Local Chat",
      "properties": {
        "fahhLocalChat.provider": {
          "type": "string",
          "enum": [
            "groq",
            "gemini",
            "nvidia",
            "openrouter",
            "anthropic",
            "ollama"
          ],
          "default": "groq",
          "description": "Which model provider the agent uses (/provider in the chat). Keys are kept in VS Code secret storage, one per provider."
        },
        "fahhLocalChat.model": {
          "type": "string",
          "default": "",
          "description": "Model id for the provider (/model in the chat lists what your key can use)."
        },
        "fahhLocalChat.mode": {
          "type": "string",
          "enum": [
            "normal",
            "accept-edits",
            "smart",
            "plan",
            "bypass"
          ],
          "default": "normal",
          "description": "Permission mode for new prompts: normal asks before every edit and command."
        },
        "fahhLocalChat.binary": {
          "type": "string",
          "default": "",
          "description": "Path to the Fahh Editor program (fahh-editor.exe) or to fahh-agent. Empty finds the installed Fahh Editor."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "publish-update": "bash scripts/publish-update.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
