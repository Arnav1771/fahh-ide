{
  "name": "fahh-local-chat",
  "displayName": "Fahh Familiar",
  "description": "Fahh Familiar: Fahh Editor's coding agent (fahh-agent) as a chat in VS Code. It reads, edits and runs things in your workspace, and asks before it changes anything. @ mentions, real diffs, undo per turn. Groq, Gemini, NVIDIA, OpenRouter, Anthropic or a local Ollama.",
  "version": "0.4.0",
  "publisher": "stealth-keqing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arnav1771/fahh-ide"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "agent",
    "ai",
    "anthropic",
    "fahh",
    "familiar",
    "gemini",
    "groq",
    "ollama",
    "openrouter"
  ],
  "icon": "media/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fahhLocalChat",
          "title": "Fahh Familiar",
          "icon": "media/bot.svg"
        }
      ]
    },
    "views": {
      "fahhLocalChat": [
        {
          "type": "webview",
          "id": "fahhLocalChat.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "fahhLocalChat.newSession",
        "title": "Fahh Familiar: New Session",
        "icon": "$(add)"
      },
      {
        "command": "fahhLocalChat.resume",
        "title": "Fahh Familiar: Resume a Session",
        "icon": "$(history)"
      },
      {
        "command": "fahhLocalChat.pickModel",
        "title": "Fahh Familiar: Choose Model",
        "icon": "$(server-environment)"
      },
      {
        "command": "fahhLocalChat.pickProvider",
        "title": "Fahh Familiar: Choose Provider"
      },
      {
        "command": "fahhLocalChat.setApiKey",
        "title": "Fahh Familiar: Manage API Keys",
        "icon": "$(key)"
      },
      {
        "command": "fahhLocalChat.settings",
        "title": "Fahh Familiar: Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "fahhLocalChat.stop",
        "title": "Fahh Familiar: Stop",
        "icon": "$(debug-stop)"
      },
      {
        "command": "fahhLocalChat.checkForUpdates",
        "title": "Fahh Familiar: Check for Updates"
      },
      {
        "command": "fahhLocalChat.askAboutSelection",
        "title": "Fahh Familiar: Ask Fahh Familiar about this",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "fahhLocalChat.export",
        "title": "Fahh Familiar: Export Chat to Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "fahhLocalChat.permissions",
        "title": "Fahh Familiar: Auto-approve Rules",
        "icon": "$(checklist)"
      },
      {
        "command": "fahhLocalChat.pickMode",
        "title": "Fahh Familiar: Choose Mode"
      },
      {
        "command": "fahhLocalChat.statusMenu",
        "title": "Fahh Familiar: Quick Menu"
      },
      {
        "command": "fahhLocalChat.acceptEdit",
        "title": "Fahh Familiar: Accept This Edit",
        "icon": "$(check)"
      },
      {
        "command": "fahhLocalChat.rejectEdit",
        "title": "Fahh Familiar: Reject This Edit",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fahhLocalChat.newSession",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@1"
        },
        {
          "command": "fahhLocalChat.resume",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@2"
        },
        {
          "command": "fahhLocalChat.settings",
          "when": "view == fahhLocalChat.chat",
          "group": "navigation@3"
        },
        {
          "command": "fahhLocalChat.pickModel",
          "when": "view == fahhLocalChat.chat",
          "group": "more@1"
        },
        {
          "command": "fahhLocalChat.setApiKey",
          "when": "view == fahhLocalChat.chat",
          "group": "more@2"
        },
        {
          "command": "fahhLocalChat.export",
          "when": "view == fahhLocalChat.chat",
          "group": "more@3"
        },
        {
          "command": "fahhLocalChat.permissions",
          "when": "view == fahhLocalChat.chat",
          "group": "more@4"
        }
      ],
      "editor/context": [
        {
          "command": "fahhLocalChat.askAboutSelection",
          "when": "editorHasSelection",
          "group": "fahh@1"
        }
      ],
      "editor/title": [
        {
          "command": "fahhLocalChat.acceptEdit",
          "when": "resourceScheme == fahh-proposed",
          "group": "navigation@1"
        },
        {
          "command": "fahhLocalChat.rejectEdit",
          "when": "resourceScheme == fahh-proposed",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "fahhLocalChat.acceptEdit",
          "when": "false"
        },
        {
          "command": "fahhLocalChat.rejectEdit",
          "when": "false"
        },
        {
          "command": "fahhLocalChat.statusMenu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Fahh Familiar",
      "properties": {
        "fahhLocalChat.provider": {
          "type": "string",
          "enum": [
            "groq",
            "gemini",
            "nvidia",
            "openrouter",
            "anthropic",
            "ollama"
          ],
          "default": "groq",
          "description": "Which model provider the agent uses (/provider in the chat). Keys are kept in VS Code secret storage, one per provider."
        },
        "fahhLocalChat.model": {
          "type": "string",
          "default": "",
          "description": "Model id for the provider (/model in the chat lists what your key can use)."
        },
        "fahhLocalChat.mode": {
          "type": "string",
          "enum": [
            "normal",
            "accept-edits",
            "smart",
            "plan",
            "bypass"
          ],
          "default": "normal",
          "description": "Permission mode for new prompts: normal asks before every edit and command. The auto-approve rules can raise it."
        },
        "fahhLocalChat.binary": {
          "type": "string",
          "default": "",
          "description": "Path to the Fahh Editor program (fahh-editor.exe) or to fahh-agent. Empty finds the installed Fahh Editor."
        },
        "fahhLocalChat.autoApprove.edits": {
          "type": "string",
          "enum": [
            "ask",
            "always"
          ],
          "enumDescriptions": [
            "Ask before every edit (with a diff)",
            "Apply edits without asking (accept-edits mode)"
          ],
          "default": "ask",
          "markdownDescription": "Auto-approve file edits. Reads are always allowed. Raises the mode to accept-edits; plan and /ask stay read-only. Also `/permissions` in the chat."
        },
        "fahhLocalChat.autoApprove.commands": {
          "type": "string",
          "enum": [
            "ask",
            "always"
          ],
          "enumDescriptions": [
            "Ask before every command",
            "Run commands and apply edits without asking (bypass mode)"
          ],
          "default": "ask",
          "markdownDescription": "Auto-approve commands. A command can change any file, so **always** also applies edits without asking (the agent's bypass mode). The agent's built-in blocks and deny rules in `.fahh/permissions.json` still apply."
        }
      }
    },
    "keybindings": [
      {
        "command": "fahhLocalChat.askAboutSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "publish-update": "bash scripts/publish-update.sh"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0"
  }
}
